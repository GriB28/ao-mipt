# Только http: сертификата ещё нет (первый запуск) или это проверка
# сборки у себя на компьютере. Как только сертификат выпущен, при
# следующем старте nginx переключится на https.conf.template.

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # Проверка Let's Encrypt при выпуске сертификата.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/olymp/locations.conf;
}
