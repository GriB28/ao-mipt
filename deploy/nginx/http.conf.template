# Конфигурация nginx для работы за внешним обратным прокси (или локально).
# SSL терминируется на глобальном веб-сервере хоста.

# Счётчик запросов для входа и регистрации (см. locations.conf):
# 30 в минуту с одного адреса, 429 при превышении.
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/olymp/locations.conf;
}
