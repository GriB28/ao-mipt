# Образец настроек. Скопируйте в .env и поправьте под себя:
#
#     cp .env.example .env
#
# Этот файл лежит в репозитории, .env — нет: в нём пароли и ключи.
#
# ДЛЯ РАБОТЫ НА СВОЁМ КОМПЬЮТЕРЕ ничего заполнять не нужно, кроме одной
# строки ниже: DEBUG=True. Всё остальное подставится само — база будет
# SQLite в папке проекта, письма вместо отправки напечатаются в терминал.

# --- Основное -------------------------------------------------------------
# True — для работы на своём компьютере, False — на сервере.
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Адреса, по которым сайт разрешено открывать. При DEBUG=True не нужны.
ALLOWED_HOSTS=olymp.example.ru,www.olymp.example.ru
CSRF_TRUSTED_ORIGINS=https://olymp.example.ru

# --- База данных ----------------------------------------------------------
# Пусто — SQLite в файле db.sqlite3 рядом с проектом, ставить ничего не надо.
# На сервере: postgres://пользователь:пароль@db:5432/имя_базы
DATABASE_URL=

# --- Файлы ----------------------------------------------------------------
# Пусто — папка media/ рядом с проектом. /app/media — путь внутри Docker.
MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=20

# --- Почта ----------------------------------------------------------------
# Не отправляйте письма напрямую с VPS — попадут в спам. Нужен SMTP-релей.
# Какой ящик заводить и почему Яндекс, а не Gmail — docs/contacts.md.
# Для Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, обычный пароль SMTP не примет.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=olymp@example.ru

# --- Публичные контакты (подвал сайта) ------------------------------------
CONTACT_EMAIL=olymp@example.ru
# Техническая поддержка по сайту — заведите отдельный ящик, см. docs/contacts.md
SUPPORT_EMAIL=
TELEGRAM_URL=https://t.me/имя_канала
TELEGRAM_CHAT_URL=
VK_URL=

# --- Карты ----------------------------------------------------------------
# Ключ JavaScript API Яндекс.Карт. Без него карта рисуется OpenStreetMap.
# Получить: https://developer.tech.yandex.ru/services (тариф «Бесплатный»)
YANDEX_MAPS_API_KEY=

# --- Прочее ---------------------------------------------------------------
LOG_LEVEL=INFO

# Только для docker-compose (создание базы в контейнере):
POSTGRES_DB=olymp
POSTGRES_USER=olymp
POSTGRES_PASSWORD=
