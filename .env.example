# Образец настроек. Скопируйте в .env и поправьте под себя:
#
#     cp .env.example .env
#
# Этот файл лежит в репозитории, .env — нет: в нём пароли и ключи.
#
# ДЛЯ РАБОТЫ НА СВОЁМ КОМПЬЮТЕРЕ ничего заполнять не нужно, кроме одной
# строки ниже: DEBUG=True. Всё остальное подставится само — база будет
# SQLite в папке проекта, письма вместо отправки напечатаются в терминал.

# --- Основное -------------------------------------------------------------
# True — для работы на своём компьютере, False — на сервере.
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Адреса, по которым сайт разрешено открывать. При DEBUG=True не нужны.
ALLOWED_HOSTS=olymp.example.ru
CSRF_TRUSTED_ORIGINS=https://olymp.example.ru
# False — только для проверки Docker-сборки у себя по http://localhost.
# На сервере всегда True: сайт работает только по https.
USE_HTTPS=True

# --- База данных ----------------------------------------------------------
# Пусто — SQLite в файле db.sqlite3 рядом с проектом, ставить ничего не надо.
# На сервере: postgres://пользователь:пароль@db:5432/имя_базы
DATABASE_URL=

# --- Файлы ----------------------------------------------------------------
# Пусто — папка media/ рядом с проектом. В Docker задаётся в docker-compose.yml.
MEDIA_ROOT=
# Предел на файл: для организаторов (материалы задач, презентации)
# и для школьников (решения, сканы согласий; фото сжимаются в браузере).
MAX_UPLOAD_SIZE_MB=20
PARTICIPANT_UPLOAD_MAX_MB=2
# Пределы, защищающие диск: файлов в одной отправке и отправок на задачу.
MAX_FILES_PER_SUBMISSION=10
MAX_ATTEMPTS_PER_PROBLEM=30
# /healthz/ сообщит о проблеме, если свободного места меньше (ГБ).
HEALTHZ_MIN_FREE_GB=2

# --- Почта ----------------------------------------------------------------
# Не отправляйте письма напрямую с VPS — попадут в спам. Нужен SMTP-релей.
# Какой ящик заводить и почему Яндекс, а не Gmail — docs/contacts.md.
# Для Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, обычный пароль SMTP не примет.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=olymp@example.ru

# --- Публичные контакты (подвал сайта) ------------------------------------
CONTACT_EMAIL=olymp@example.ru
# Техническая поддержка по сайту — заведите отдельный ящик, см. docs/contacts.md
SUPPORT_EMAIL=
TELEGRAM_URL=https://t.me/имя_канала
TELEGRAM_CHAT_URL=
VK_URL=

# --- Карты ----------------------------------------------------------------
# Ключ JavaScript API Яндекс.Карт. Без него карта рисуется OpenStreetMap.
# Получить: https://developer.tech.yandex.ru/services (тариф «Бесплатный»)
YANDEX_MAPS_API_KEY=

# --- Прочее ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Сервер (docker compose) ---------------------------------------------
# Всё ниже нужно только на сервере. Порядок развёртывания — docs/deploy.md.

# Домен сайта, без https://. Пусто — nginx работает по http без сертификата.
DOMAIN=
# Почта для уведомлений Let's Encrypt (истекает сертификат и т.п.).
LETSENCRYPT_EMAIL=

# База в контейнере. Пароль server-setup.sh генерирует сам.
POSTGRES_DB=olymp
POSTGRES_USER=olymp
POSTGRES_PASSWORD=

# Процессы gunicorn. 3 хватает на обычные дни; перед дедлайном — 5.
GUNICORN_WORKERS=3
# Предел одного запроса в nginx. В одной отправке может быть несколько
# файлов по MAX_UPLOAD_SIZE_MB, поэтому он заметно больше.
CLIENT_MAX_BODY_SIZE=100m

# Бэкап: во сколько (час по UTC, 00 = 03:00 МСК) и сколько дней хранить.
BACKUP_HOUR_UTC=00
BACKUP_KEEP_DAYS=7
# Открытый ключ age («age1…») — бэкапы шифруются им. В них паспортные
# данные и сканы согласий, поэтому на сервере с участниками ОБЯЗАТЕЛЬНО.
# Как создать пару ключей — docs/deploy.md, «Бэкапы».
BACKUP_AGE_RECIPIENT=
